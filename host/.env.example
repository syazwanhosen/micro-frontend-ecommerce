# Where the host looks for each remote's remoteEntry.js.
#
# Unset, the host falls back to localhost ports in dev and same-origin
# subpaths (/catalog, /cart, /checkout) in a production build — the bundled
# deploy. Set any one of these to point that remote at its own deployment;
# the others keep their default, so remotes can be split out one at a time.
#
# These are read at BUILD time, not runtime: changing one means rebuilding
# the host. Changing what a remote *contains* does not.

# VITE_REMOTE_CATALOG=https://orbit-catalog.vercel.app
# VITE_REMOTE_CART=https://orbit-cart.vercel.app
# VITE_REMOTE_CHECKOUT=https://orbit-checkout.vercel.app
